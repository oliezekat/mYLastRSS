{
    "name": "oliezekat/mylastrss",
    "type": "library",
    "description": "Simple yet powerfull class to parse several RSS & Atom feeds",
    "keywords": ["rss","rdf","atom","feed","parser","aggregator"],
    "license": "GPL-2.0-only",
    "authors": [
        {
        "name": "oliezekat",
        "email": "oliezekat@yahoo.fr",
        "homepage": "https://life2front.com/oliezekat/"
        }
    ],
    "require": {
        "php": ">=5.6"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13 || ^4.0",
        "phpunit/phpunit": "^5.7 || ^9.6"
    },
    "suggest": {
        "ext-openssl": "Enables access to feeds over HTTPS",
        "rmccue/requests": "For using Requests as a HTTP client transport"
    },
    "autoload": {
        "files": [
            "mylastrss/mylastrss.class.php",
            "mylastrss/misc/mylr2rss/mylr2rss.class.php"
        ],
        "exclude-from-classmap": [
            "/mylastrss/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Oliezekat\\MyLastRss\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/samples/"
        ]
    },
    "config": {
        "audit": {
            "ignore": {
                "GHSA-vvj3-c3rp-c85p": "Still need use PHPUnit 5.7 to run tests under PHP 5.6"
            }
        }
    }    
}
